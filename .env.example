# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- GitLab (ведение проекта) ---
GITLAB_NAME=
GITLAB_PASS=

# --- TrueConf: хост, на котором развёрнут TrueConf Server (SSH и веб-панель) ---
TRUECONF_PATH=http://trueconf.example.com
TRUECONF_USER=
TRUECONF_PASS=

# --- TrueConf: учётная запись бота для интеграции (создаётся в панели /admin/) ---
TRUECONF_BOT_USER=bot@example.trueconf.name
TRUECONF_BOT_PASS=
# Кому бот отправляет тестовые сообщения (TrueConf ID пользователя)
TRUECONF_TARGET_USER=admin@example.trueconf.name
